{
  "name": "testrill",
  "version": "0.1.0",
  "private": true,
  "description": "A local testing workbench for people and agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedy69/testrill.git"
  },
  "homepage": "https://github.com/tedy69/testrill#readme",
  "bugs": {
    "url": "https://github.com/tedy69/testrill/issues"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:engine": "tsx src/entry.ts serve --port 4317",
    "build": "npm run typecheck && vite build && node scripts/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "cli": "tsx src/entry.ts",
    "mcp": "tsx src/entry.ts mcp",
    "browsers:install": "playwright install chromium",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "npm run desktop:prepare && tauri build",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "tsx scripts/export-schema.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "native:check-patches": "node scripts/check-native-patches.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "fflate": "^0.8.3",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "marked": "^18.2.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "yaml": "^2.9.1"
  }
}
