{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rehearsal",
  "version": "0.1.0",
  "identifier": "dev.rehearsal.workbench",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:ui"
  },
  "app": {
    "windows": [
      {
        "title": "Rehearsal",
        "width": 1360,
        "height": 900,
        "minWidth": 360,
        "minHeight": 620,
        "backgroundColor": "#f6f5f0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "externalBin": ["binaries/rehearsal-node"],
    "resources": { "resources/runtime/": "runtime/" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
